{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "strict":            true,
    "esModuleInterop":   true,
    "resolveJsonModule": true,
    "outDir":            "dist",
    "sourceMap":         true,
    "skipLibCheck":      true,
    "types":             ["node"]
  },
  "include": ["features/**/*.ts", "pages/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}